<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Droplet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>droplet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ═══════════════════════════════════════════════════════════════
	     PERMISSIONS RÉSEAU MESH — BLE + Wi-Fi Local
	     ═══════════════════════════════════════════════════════════════ -->

	<!-- BLE :.DESCRIPTION POUR LA DEMANDE D'AUTORISATION -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Droplet utilise le Bluetooth pour découvrir et communiquer avec vos amis proches sur le réseau mesh, même quand l'app est en arrière-plan.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Droplet utilise le Bluetooth pour communiquer avec les appareils proches sur le mesh.</string>

	<!-- RÉSEAU LOCAL : ACCÈS AUX APAREILS PROCHES (Wi-Fi Direct / mDNS) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Droplet utilise le réseau local pour découvrir et échanger des données avec les appareils proches sur le mesh, sans connexion Internet.</string>

	<!-- BONJOUR : SERVICE TYPE UTILISÉ POUR LA DÉCOUVERTE mDNS -->
	<key>NSBonjourServices</key>
	<array>
		<string>_ouroprep._tcp</string>
	</array>

	<!-- LOCALISATION : REQUISE POUR LE BLE SUR iOS (scanning BLE) -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Droplet utilise la localisation pour le scanning Bluetooth et la découverte de pairs proches.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Droplet utilise la localisation en arrière-plan pour maintenir la connexion mesh avec vos amis.</string>

	<!-- MICROPHONE : POUR LES APPELS MESH -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Droplet utilise le microphone pour les appels audio et vocaux sur le mesh.</string>

	<!-- CAMÉRA : POUR LES APPELS VIDÉO ET QR CODE -->
	<key>NSCameraUsageDescription</key>
	<string>Droplet utilise la caméra pour les appels vidéo et le scan de QR codes d'amis.</string>

	<!-- PHOTOthèque : ENVOI D'IMAGES DANS LES MESSAGES -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Droplet accède à vos photos pour les envoyer dans les conversations mesh.</string>

	<!-- TÂCHES D'ARRIÈRE-PLAN : BLE CONTINU + SYNC MESH -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
		<string>processing</string>
	</array>

	<!-- ═══════════════════════════════════════════════════════════════
	     FIN PERMISSIONS MESH
	     ═══════════════════════════════════════════════════════════════ -->

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
