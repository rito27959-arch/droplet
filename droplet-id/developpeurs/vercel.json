{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cp ../kits/js/src/droplet-id.js droplet-id.js",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [{ "source": "/bac-a-sable", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; connect-src 'self' https://id-test.dropletmesh.app https://id.dropletmesh.app; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
