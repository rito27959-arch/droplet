# ============================================================================
# VARIABLES D'ENVIRONNEMENT — NE PAS COMMITTER CE FICHIER
# ============================================================================
#
# Ce fichier contient les tokens et secrets. NE LE JAMAIS PUSHER SUR GITHUB.
#
# UTILISATION :
#   1. Copie ce fichier : cp .env.example .env
#   2. Remplis les valeurs
#   3. Lance : ./scripts/build-ipa.sh
# ============================================================================

# ── GITHUB ──────────────────────────────────────────────────────────────
# Token GitHub avec accès aux Actions (Settings → Developer settings → Personal access tokens)
# ⚠️  CRÉE UN NOUVEAU TOKEN — celui envoyé précédemment est compromis
GITHUB_TOKEN=ghp_TON_TOKEN_ICI

# Dépôt GitHub (format : owner/repo)
GITHUB_REPO=ton-user/ton-repo

# ── APPLE (pour référence — configure-les dans GitHub Secrets) ──────────
# Ces valeurs vont dans GitHub Settings → Secrets → Actions, pas ici.
#
# APPLE_CERTIFICATE_P12=base64_du_p12
# APPLE_CERTIFICATE_PASSWORD=mot_de_passe_p12
# APPLE_TEAM_ID=ABCDEF1234
# APPLE_PROVISION_PROFILE=base64_du_mobileprovision
